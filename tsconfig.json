{
	// `$app/tsconfig` is generated by `svelte-kit sync` into node_modules. It
	// wires up the `$lib` / `$app` / `$env` aliases and the per-route
	// `./$types` modules, and sets the interop options Vite requires. Extending
	// it means those stay correct automatically as routes are added.
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		// `#lib/*` is declared in package.json's `imports` field, which is how
		// Vite, Rolldown and Node all resolve it at build and run time.
		// TypeScript, however, does not perform extension inference through
		// `imports`: it resolves `#lib/types/auth` to `src/lib/types/auth`
		// and then stops, without trying `.ts`.
		//
		// So the same mapping is restated here, where TypeScript DOES infer
		// extensions. Both entries are required and must stay in step:
		//
		//   package.json "imports"  ->  the bundler and the runtime
		//   this "paths" entry      ->  the type checker and the editor
		//
		// Deleting either one breaks half the toolchain, in a way the other
		// half will not report. (An array fallback such as
		// `["./src/lib/*.ts", "./src/lib/*"]` satisfies TypeScript on its own
		// but Rolldown does not honour the fallback, so that is not a fix.)
		"paths": {
			"#lib/*": ["./src/lib/*"]
		},

		// The base config deliberately leaves strictness to us. Everything
		// below is an addition, not a restatement.

		// No implicit `any`, no unchecked `null`/`undefined`. This is the
		// single most valuable setting in the file.
		"strict": true,

		// Dead code becomes a build failure rather than accumulating quietly.
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		// A `case` that falls through must say so explicitly.
		"noFallthroughCasesInSwitch": true,

		// `array[0]` is typed `T | undefined`, not `T`. Matters for the
		// paginated queries we will write: an empty page must be handled,
		// not assumed away.
		"noUncheckedIndexedAccess": true,

		// A function whose return type includes a value must return on every
		// code path.
		"noImplicitReturns": true,

		// Optional properties are `T | undefined` on write as well as read,
		// so `{ foo: undefined }` cannot be passed where `{ foo?: string }`
		// is expected. Keeps "absent" and "explicitly undefined" distinct.
		"exactOptionalPropertyTypes": true
	}
}
