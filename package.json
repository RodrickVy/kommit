{
	"name": "kommitly",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.17 || >=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:migration": "supabase migration new",
		"db:push": "supabase db push",
		"db:diff": "supabase db diff -f",
		"db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
		"db:types:local": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
		"fn:serve": "supabase functions serve",
		"fn:deploy": "supabase functions deploy",
		"setup:platform-wallet": "node --env-file=.env scripts/invoke-function.mjs setup_platform_wallet",
		"setup:charity-wallets": "node --env-file=.env scripts/setup-charity-wallets.mjs",
		"run:process-commitments": "node --env-file=.env scripts/invoke-function.mjs process_commitments",
		"verify:commitments": "node --env-file=.env scripts/verify-commitment-flow.mjs"
	},
	"dependencies": {
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.117.2",
		"mapbox-gl": "3.32.0",
		"qrcode": "1.5.4"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "7.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/qrcode": "1.5.6",
		"supabase": "2.119.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.2"
	}
}
