# Record exact versions in package.json rather than caret ranges, so that
# `npm install <pkg>` pins what it actually installed. Combined with the
# already-pinned versions in package.json, this means a dependency only ever
# moves when someone deliberately bumps it — never because a maintainer
# published a patch.
#
# This matters more than usual here: SvelteKit 3 was released on 2026-10-01,
# so patch releases are expected. We want to adopt them on purpose, having
# read the changelog, rather than silently on the next `npm install`.
save-exact=true

# Refuse to install when the local Node version does not satisfy the "engines"
# field in package.json (^22.17 || >=24). Without this npm only warns, and the
# failure surfaces later as a confusing runtime or build error instead of at
# install time.
engine-strict=true
