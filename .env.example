# ==============================================================================
# kommit — environment variables
# ==============================================================================
#
# Copy this file to `.env` and fill in the blanks:
#
#     cp .env.example .env
#
# `.env` is gitignored. This file is committed and must never contain a real
# value.
#
# NAMING RULE (enforced by SvelteKit, not by convention):
#
#   PUBLIC_*  is inlined into the JavaScript sent to the browser. Anyone can
#             read it with view-source. Only ever put non-secret values here.
#
#   everything else is server-only. SvelteKit refuses to import it from client
#             code, so a leak becomes a build error rather than a breach.
#
# Each variable below is read through a single validated accessor — never via
# `process.env` directly:
#
#   PUBLIC_*  ->  src/lib/config/public-env.ts
#   secrets   ->  src/lib/server/config/private-env.ts
#
# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
# Dashboard -> Project Settings -> API

# Base URL of the Supabase project, e.g. https://abcdefgh.supabase.co
# For local development against `supabase start`, this is http://127.0.0.1:54321
PUBLIC_SUPABASE_URL=

# The `anon` key. Safe to expose: it carries no privileges of its own and every
# request made with it is still filtered by Row Level Security.
PUBLIC_SUPABASE_ANON_KEY=

# The `service_role` key. SECRET.
# It BYPASSES Row Level Security completely and can read or write any row in
# the database. Only ever used from `src/lib/server/supabase/admin.ts`, and only
# for operations that are deliberately not user-scoped (webhooks, scheduled
# jobs, administrative repair). Never pass it to a page or a component.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
# Dashboard -> Storage

# Name of the Supabase Storage bucket holding listing images. Public, because
# the browser needs it to build image URLs. Access to the objects themselves is
# governed by the bucket's own storage policies, not by hiding this name.
PUBLIC_SUPABASE_LISTINGS_BUCKET=kommit_media

# ------------------------------------------------------------------------------
# Solana
# ------------------------------------------------------------------------------

# Which Solana cluster the app is pointed at: `devnet`, `testnet` or
# `mainnet-beta`. Drives explorer links and is shown in the UI so it is always
# obvious which network a balance or signature belongs to.
PUBLIC_SOLANA_NETWORK=devnet

# JSON-RPC endpoint used to read chain state and submit transactions.
# The public endpoint below is heavily rate-limited and is fine for development
# only; production should point at a dedicated provider.
PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ------------------------------------------------------------------------------
# Wallet / Treasury
# ------------------------------------------------------------------------------

# Base58 public key of the treasury account that holds staked commitment funds.
# Not secret — it is an on-chain address and is visible to anyone inspecting a
# transaction. Kept server-side for now because nothing in the UI needs it yet.
SOLANA_TREASURY_PUBLIC_KEY=

# Secret key for the treasury account. SECRET, AND IRREVERSIBLE IF LEAKED:
# whoever holds it can move every lamport in the treasury.
#
#   - never commit it, never log it, never return it from a load function
#   - in production it belongs in the Vercel encrypted environment store,
#     not in a file on disk
#   - for anything beyond development, a signing service or an HSM/KMS should
#     hold this instead of the application process
SOLANA_TREASURY_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------

# Absolute origin the app is served from, with no trailing slash. Used to build
# absolute URLs that cannot be derived from a relative path: auth email
# redirects, OAuth callbacks and share links.
#
#   local       http://localhost:5173
#   preview     https://<deployment>.vercel.app
#   production  https://<your-domain>
PUBLIC_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Email (SendGrid)
# ------------------------------------------------------------------------------
# NOT WIRED UP YET. Declared so deployment environments can be configured ahead
# of the feature. Leave empty until email is built — the app starts without them.
#
# Two ways to combine Supabase Auth with SendGrid, needing different things:
#
#   1. SMTP — Supabase Auth sends verification and recovery mail itself through
#      SendGrid's SMTP relay. Configured in the Supabase dashboard under
#      Authentication -> SMTP Settings. The credentials live THERE, not here,
#      so none of the variables below are used. Less code; Supabase's templates.
#
#   2. SendGrid API — we send the mail ourselves. That is what these are for.
#      Full control over templates, at the cost of owning the delivery path.
#
# If option 1 is chosen, delete these rather than leaving dead config behind.

# SendGrid API key. SECRET.
# Grants the ability to send mail as our verified domain, so a leak lets someone
# send email that appears to come from us. Scope it to "Mail Send" only — a
# full-access key can also read contacts and suppression lists.
SENDGRID_API_KEY=

# Address outbound mail is sent from. Must be a sender SendGrid has verified,
# or delivery fails outright.
SENDGRID_FROM_EMAIL=

# Display name shown beside the from address, e.g. "kommit". Optional even once
# email is live; SendGrid falls back to showing the bare address.
SENDGRID_FROM_NAME=
